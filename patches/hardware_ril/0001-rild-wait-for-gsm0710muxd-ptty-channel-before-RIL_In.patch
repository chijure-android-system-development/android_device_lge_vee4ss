From 66efcb16b6e263c11bdf6de7180d8a7c7aeebbb7 Mon Sep 17 00:00:00 2001
From: Juan Manuel Reategui Solis <reateguisolisjm@gmail.com>
Date: Sun, 28 Jun 2026 15:49:03 -0500
Subject: [PATCH] rild: wait for gsm0710muxd ptty channel before RIL_Init

mtk-ril.so opens /dev/radio/pttycmd1 during RIL_Init. On fast modem
boots (NORMAL_BOOT_ID at ~7s), gsm0710muxd may not have created the
ptty devices yet when rild starts as class main (~8-10s). This causes
RIL_Init to return NULL, RIL_register to fail, and the RIL to be
permanently dead for the boot.

Poll up to 15 s for /dev/radio/pttycmd1 to appear before calling
RIL_Init. On typical boots this check passes immediately (no delay);
the poll ensures correctness if rild races ahead of gsm0710muxd.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
Change-Id: Ic20529db64096efd122ae0b58e8f4880525b1f2b
---
 rild/rild.c | 46 +++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 43 insertions(+), 3 deletions(-)

diff --git a/rild/rild.c b/rild/rild.c
index 77dec1e..ee655b7 100644
--- a/rild/rild.c
+++ b/rild/rild.c
@@ -57,10 +57,35 @@ extern void RIL_requestTimedCallback (RIL_TimedCallback callback,
                                void *param, const struct timeval *relativeTime);
 
 
-static struct RIL_Env s_rilEnv = {
+/*
+ * MTK Gemini RIL (mtk-ril.so / librilmtk.so) reads 24 bytes (6 pointers) from
+ * the RIL_Env passed to RIL_Init, but AOSP RIL_Env only defines 3 callbacks
+ * (12 bytes).  Bytes 12-23 would be NULL/garbage, causing a SIGSEGV when
+ * mtk-ril.so calls env->field_16(token) to pick the AT-channel index.
+ *
+ * Extend the env with 3 MTK-specific stubs so those slots are never NULL.
+ * field_16 returns 0 = "always use AT channel 0 / proxy 0" (safe for single-SIM).
+ */
+typedef struct {
+    void (*OnRequestComplete)(RIL_Token t, RIL_Errno e, void *response, size_t responselen);
+    void (*OnUnsolicitedResponse)(int unsolResponse, const void *data, size_t datalen);
+    void (*RequestTimedCallback)(RIL_TimedCallback callback, void *param,
+                                 const struct timeval *relativeTime);
+    void (*mtkField12)(void *);          /* MTK extension — purpose unknown, stub */
+    int  (*mtkField16)(void *);          /* returns AT-channel index (0-3) for token */
+    void (*mtkField20)(void *);          /* MTK extension — purpose unknown, stub */
+} MtkRilEnv;
+
+static void mtkEnvNop(void *arg __attribute__((unused))) { }
+static int  mtkEnvChannel(void *arg __attribute__((unused))) { return 0; }
+
+static MtkRilEnv s_rilEnv = {
     RIL_onRequestComplete,
     RIL_onUnsolicitedResponse,
-    RIL_requestTimedCallback
+    RIL_requestTimedCallback,
+    mtkEnvNop,      /* field 12 */
+    mtkEnvChannel,  /* field 16 — channel selector, always 0 */
+    mtkEnvNop,      /* field 20 */
 };
 
 extern void RIL_startEventLoop();
@@ -272,7 +297,22 @@ OpenLib:
     // Make sure there's a reasonable argv[0]
     rilArgv[0] = argv[0];
 
-    funcs = rilInit(&s_rilEnv, argc, rilArgv);
+    /* mtk-ril.so opens /dev/radio/pttycmd1 inside RIL_Init.
+     * gsm0710muxd creates that device asynchronously after modem boot.
+     * Poll up to 15 s so RIL_Init sees the device and returns a valid struct. */
+    {
+        static const char kPttyDev[] = "/dev/radio/pttycmd1";
+        int waited_ms = 0;
+        while (access(kPttyDev, F_OK) != 0 && waited_ms < 15000) {
+            ALOGD("rild: waiting for %s (%d ms elapsed)", kPttyDev, waited_ms);
+            usleep(200 * 1000);
+            waited_ms += 200;
+        }
+        if (access(kPttyDev, F_OK) != 0)
+            ALOGE("rild: %s still absent after 15 s, proceeding anyway", kPttyDev);
+    }
+
+    funcs = rilInit((const struct RIL_Env *)&s_rilEnv, argc, rilArgv);
 
     RIL_register(funcs);
 
