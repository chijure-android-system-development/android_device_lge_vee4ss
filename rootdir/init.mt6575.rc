# LG L4 II (vee4ss): everything shared with the L5 II lives in
# device/lge/mt6575-common/rootdir/root/init.mt6575.common.rc.
import /init.mt6575.common.rc

on boot
    chown system graphics /dev/mtkfb_vsync
    chmod 0660 /dev/mtkfb_vsync

# Hands off the LK/preloader boot logo to the kernel fb driver's own
# logo — without this the display stays frozen on the bootloader splash
# even once Android is fully up and drawing (stock service, oneshot).
service bootlogoupdater /system/bin/boot_logo_updater
    oneshot

# Accelerometer/magnetometer daemon of this board's BMC150
service bmc150d /system/bin/bmc150d
    class main
    user system
    group system
    oneshot
